{
  "routes": [
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/style.css",
      "dest": "/style.css"
    },
    {
      "src": "/api/(.*)",
      "dest": "/WebUMKM/api/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/WebUMKM/assets/$1"
    },
    {
      "src": "/includes/(.*)",
      "dest": "/WebUMKM/includes/$1"
    }
  ]
}